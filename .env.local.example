# Copy to .env.local (gitignored) and fill in — never commit real values.

# Supabase project: helloModa (eu-central-1 / Frankfurt), ref hdbwcjtvbjeisgtpisne
NEXT_PUBLIC_SUPABASE_URL=https://hdbwcjtvbjeisgtpisne.supabase.co
# This is the publishable/anon key — safe to expose client-side, RLS does the real gating.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-PD2g8SbkwNftB5zzrWf8Q_9xlXp56N

# Shared invite code required to register at /register — server-only, never
# NEXT_PUBLIC_*. Ask Silviu for the real value; don't commit it here.
INVITE_CODE=

# Required for real chat (POST /api/chat) — server-only, never NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=

# Error monitoring (Sentry) and product analytics (PostHog) — Phase 0 exit
# criterion, wired up 2026-09-20. Both are safe no-ops with these unset; set
# them once real Sentry/PostHog projects exist. The Sentry DSN is meant to be
# public (it only lets you send events in, not read data out).
NEXT_PUBLIC_SENTRY_DSN=
# Only needed at build time, to upload source maps for readable stack traces
# (e.g. set in Vercel, not local dev):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Phase 2 — real outfit-image generation (POST /api/generate-image), via
# Replicate. Server-only, never NEXT_PUBLIC_*.
REPLICATE_API_TOKEN=

# Phase 3 — affiliate product catalog sync (scripts/sync-products-*.mjs).
# Server-only, never NEXT_PUBLIC_* — these bypass RLS and/or authenticate to
# Awin, so treat both like credentials (don't paste into chat or commit).
# Service role key: Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Awin dashboard -> Italist advertiser page -> Datafeeds (or productdata.awin.com's
# "Create-a-Feed" tool). The URL itself embeds your publisher auth token.
AWIN_ITALIST_FEED_URL=
# Only needed in Vercel, not local dev — set it there and Vercel Cron signs
# its requests to GET /api/cron/sync-products-italist with it automatically,
# so the route can reject anyone else hitting that URL. Any random string works.
CRON_SECRET=

# Phase 4+ (not wired up yet):
# STRIPE_SECRET_KEY=
